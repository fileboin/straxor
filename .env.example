# OpenCode fallback for a self-hosted/single-tenant Straxor instance.
# Do not commit .env; each logged-in user can instead save an encrypted provider
# key in Straxor, which is injected only into that user's engine process.
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OPENCODE_MODEL=openrouter/deepseek/deepseek-chat-v3-0324
OPENCODE_SMALL_MODEL=openrouter/deepseek/deepseek-chat-v3-0324
