DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-this-to-a-real-secret
ENCRYPTION_KEY=generate-a-random-64-char-hex-string-for-aes-256
CLIENT_URL=http://localhost:5173
PORT=3001
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Straxor <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# ── AI provider keys (platform fallback za single-tenant / self-hosted) ──
# Per-user ključevi se čuvaju šifrovano u bazi (Provajderi → API key u UI),
# a ovi env ključevi služe samo kao fallback kada korisnik nije sačuvao svoj.
# OpenRouter — unificirani pristup 200+ modela (ključ: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Together AI — open-source modeli (ključ: https://api.together.ai/settings/api-keys)
TOGETHER_API_KEY=

# ── GitHub OAuth (univerzalna prijava) ──
# Create a GitHub OAuth App: Settings → Developer settings → OAuth Apps → New OAuth App.
# Authorization callback URL: <APP_URL>/api/auth/github/callback (e.g. https://straxor.onrender.com/api/auth/github/callback)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# Optional but recommended: a separate secret used to sign the OAuth state param.
# Falls back to JWT_SECRET when unset.
OAUTH_STATE_SECRET=change-this-to-a-real-secret
